# Replace this before exposing the API; never commit the real key.
API_KEY=replace-with-a-long-random-secret

# VoxCPM2 GPU runtime
DEVICE=cuda
VOXCPM_MODEL_ID=openbmb/VoxCPM2
VOXCPM_OPTIMIZE=true
VOXCPM_WARMUP=true
VOXCPM_WARMUP_TEXT=مرحباً بك في الخدمة.
DEFAULT_CFG=2.0
DEFAULT_TIMESTEPS=30

# auto: prompt_text -> hi-fi; no prompt -> reference-only (skips Whisper).
# Set hifi to require a transcript, or reference to always use timbre-only cloning.
REFERENCE_MODE=auto
WHISPER_BACKEND=openai-whisper
WHISPER_PRELOAD=false
WHISPER_MODEL_NAME=large-v3
WHISPER_COMPUTE_TYPE=int8_float16
WHISPER_VAD=false

# Keep durable job inputs by default. Enable only for a single-process service
# after accepting that pending jobs cannot recover their input bytes after restart.
AUDIO_MIXER_MEMORY_JOB_INPUTS=false

# Prefer the quality-preserving soxr high-quality resampler; use librosa to roll back.
AUDIO_RESAMPLER=soxr_hq
