# ═══════════════════════════════════════════════════════════════════
# إعدادات الأداء — خطة تسريع clone_voice_and_mix (v1.0)
# كل تحسين خلف مفتاح مستقل — الافتراضيات آمنة وتفعيلها مُقاس.
# ═══════════════════════════════════════════════════════════════════

# ── عقد الجودة (لا تغيّرهما أبداً) ──
VOXCPM_TIMESTEPS=30
VOXCPM_CFG=2.0
VM_PRECISION=fp32
# ── القياس والتشخيص ──
VM_LOG_STAGES=on            # سطر JSON بتوقيتات كل مرحلة لكل طلب
VM_TMPFS_DIR=auto           # auto = /dev/shm/voxmixer إن توفر 1GB حرة

# ── المرحلة 1: إزالة الهدر ──
VM_RESAMPLER=soxr_hq        # بديل سريع عالي الجودة عن kaiser_best
VM_DB_WAL=on                # SQLite WAL (يُتجاهل على Postgres)

# ── المرحلة 1-2: التزامن ──
VM_EXECUTOR_WORKERS=2       # عمال الكرت: 2 لكروت ≥12GB، 1 لكروت 8GB
VM_PARALLEL_PREP=on         # تقرير الجودة ∥ Whisper
VM_ECAPA_ASYNC=on           # ECAPA ∥ ترميز OGG (الحالة الشائعة)
VM_ECAPA_DEVICE=cuda        # cpu للكرات الصغيرة جداً

# ── المرحلة 3: كاش حالة المتحدث (bit-exact) ──
VM_SPEAKER_CACHE=on
VM_SPEAKER_CACHE_TTL=86400
VM_SPEAKER_CACHE_MAX=12

# ── المرحلة 4: دقة الحساب والتجميع ──
VM_PRECISION=auto           # auto = bf16 على Ampere+ وإلا fp16 | off = fp32
VM_TF32=on
VM_CUDNN_BENCHMARK=on
VM_COMPILE=off              # فعّله بعد اختبار استقرار على عتادك (مكسب إضافي)
VM_COMPILE_WARMUP=3

# ── المرحلة 5: المحرك البديل (اختياري — يدعم العقد أو يسقط للرسمي) ──
VM_ENGINE=official          # official | nanovllm (يتطلب pip install nano-vllm-voxcpm)

# ── المرحلة 6: Whisper ──
VM_WHISPER_BACKEND=auto     # auto = faster-whisper إن مثبت وإلا openai-whisper
VM_WHISPER_VAD=on           # قص الصمت قبل النسخ (أسرع + يمنع الهلوسة)
VM_WHISPER_CACHE=on         # نص المرجع يُحفظ بمعرف hash

# ── المرحلة 9: الإقلاع ──
VM_WARMUP_ON_BOOT=on        # إحماء النموذج قبل فتح الاستقبال
VM_UVLOOP=on                # شغّل uvicorn بـ --loop uvloop (مفعّل ضمن uvicorn[standard])

# ═══════════════════════════════════════════════════════════════════
# طبقة v2-ultra — أضعاف مضاعفة فوق v1 (كل مفتاح مستقل، سقوط آمن)
# ═══════════════════════════════════════════════════════════════════

# ── R: كاش النتائج الكاملة (أكبر معامل: تكرار نفس الطلب < 100ms) ──
VM_RESULT_CACHE=on          # off = سلوك v1 حرفياً
VM_RESULT_CACHE_TTL=86400   # ثواني بقاء النتيجة
VM_RESULT_CACHE_MAX=64      # عدد النتائج في RAM (LRU)
VM_RESULT_CACHE_MAX_MB=256  # ميزانية بايتات RAM للطبقة الأولى

# ── Z: خط الأنابيب الصفراوي (صفر ملفات وسيطة على القرص) ──
VM_RAM_PIPELINE=on          # WAV/OGG الوسيط في الذاكرة عبر ffmpeg pipes
VM_OPUS_FASTENC=on          # libopus compression_level=4 (~2× ترميز أسرع، شفافي عملياً)

# ── E: كاش embedding ECAPA المرجعي (نصف تكلفة التقييم) ──
VM_EMBED_CACHE=on           # embedding المرجع يُحسب مرة واحدة لكل متحدث

# ── P: توازي مقاطع النص الطويل (بذور أصلية فقط — الحتمية محفوظة) ──
VM_PARALLEL_CHUNKS=on       # يسقط تلقائياً للتسلسل إذا المحرك بلا seed أصلي

# ── G: بركة المحركات متعددة GPUs (إنتاجية N× حقيقية) ──
VM_GPU_IDS=                 # مثال: 0,1,2 → نسخة نموذج لكل كرت (~5-6GB VRAM لكل نسخة)

# ── Q: تكميم أوزان weight-only (بعد بوابة جودة C فقط!) ──
VM_QUANT=off                # fp8 (~1.3-1.6× Ada+) | int8 (~1.2-1.4×) | off
                            # AudioVAE/decoder مستثنى دائماً (العقد الصلب)

# ── Whisper الأقصى ──
VM_WHISPER_BATCHED=on       # BatchedInferencePipeline(batch=8) — ~3.7× موثق

# ── مسار الخلط ──
VM_SKIP_OUTPUT_PROBE=on     # خصائص الخرج تُشتق حسابياً بدل ffprobe إضافي
VM_JOB_RAM_STAGING=on       # مدخلات الوظيفة في RAM بدل BLOB مزدوج (SQLite فقط)
VM_RAM_STAGING_MAX_MB=512   # سقف RAM للوظائف المعلقة (فوقه → BLOB تلقائياً)

# ═══════════════════════════════════════════════════════════════════
# ── v3-max: المضبوط التلقائي (AutoTuner) — كل ما تحتاجه فعلياً ──
# القاعدة: "auto" (أو 0) = AutoTuner يحسب القيمة من عتادك ويعيّنها.
# أي قيمة صريحة هنا تتفوق على المضبوط دائماً. التراجع الكامل: VM_AUTOTUNE=off
# ═══════════════════════════════════════════════════════════════════
VM_AUTOTUNE=on                 # المفتاح الرئيسي (off = سلوك v1/v2 حرفياً)
VM_AUTOTUNE_CALIBRATE=on       # معايرة RTF فعلية أثناء الإحماء (تُحفظ بالبروفايل)
VM_AUTOTUNE_FILE=storage/autotune_profile.json

# كل المتغيرات التالية تعمل تلقائياً — ثبّتها فقط إن أردت تجاوز المضبوط:
# VM_ENGINE=auto                # auto = NanoVLLM إن مثبت وقابِل، وإلا الرسمي
# VM_COMPILE=auto               # auto = reduce-overhead (CUDA Graphs) على ≥16GB
# VM_QUANT=auto                 # auto = fp8 على Ada+ / int8 على cc≥7.5 (VAE مستثنى)
# VM_PRECISION=auto             # auto = bf16 على Ampere+ / fp16 على Turing
# VM_GPU_IDS=auto               # auto = كل الكروت (بركة N محركات)
# VM_GPU_PERMITS=0              # auto = 2 على ≥16GB وإلا 1
# VM_EXECUTOR_WORKERS=0         # auto = (كروت×تصاريح) + عمال CPU
# VM_CHUNK_PARALLEL_MAX=0       # auto = تصاريح × كروت
# VM_WHISPER_MODEL=auto         # auto = keep(≥11GB) / distil-large-v3 / small
# VM_WHISPER_BATCH_SIZE=0       # auto = حسب VRAM
# VM_WHISPER_GREEDY=auto        # auto = beam=1 حتمي (~2× على المقاطع القصيرة)
# VM_ECAPA_DEVICE=auto          # auto = الكرت إن وُجد
# VM_RESULT_CACHE_MAX=0         # auto = من حجم RAM
# VM_RESULT_CACHE_MAX_MB=0      # auto = من حجم RAM
# VM_SPEAKER_CACHE_MAX=0        # auto = من حجم RAM
# VM_RAM_STAGING_MAX_MB=0       # auto = من حجم RAM
# VM_AUTO_CHUNK=on              # تقسيم تلقائي للنص الطويل (>600 حرفاً) على فواصل طبيعية
# VM_AUTO_CHUNK_CHARS=0         # auto = 600
