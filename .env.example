# scripts/prepare_env.py replaces this placeholder with a private random key.
API_KEY=replace-with-a-long-random-secret

# GPU TTS engine. nanovllm is the optimized engine; pytorch is the compatibility fallback.
TTS_ENGINE=nanovllm
DEVICE=cuda
NANO_DEVICE_INDEX=0
VOXCPM_MODEL_ID=openbmb/VoxCPM2
# 0 means automatically choose sequence count and VRAM utilization from available GPU memory.
NANO_MAX_NUM_SEQS=0
NANO_GPU_MEMORY_UTILIZATION=0
NANO_MAX_NUM_BATCHED_TOKENS=8192
NANO_MAX_MODEL_LEN=4096
NANO_MAX_GENERATE_LENGTH=2000
MAX_TARGET_TEXT_CHARS=1600
MAX_TARGET_CHUNK_CHARS=350
MAX_PROMPT_TEXT_CHARS=500
MAX_REFERENCE_DURATION_SECONDS=20
VOXCPM_OPTIMIZE=true
VOXCPM_WARMUP=true
VOXCPM_WARMUP_TEXT=مرحباً بك في الخدمة.
TORCHINDUCTOR_CACHE_DIR=./storage/torchinductor
DEFAULT_CFG=2.0
DEFAULT_TIMESTEPS=30

# auto: prompt_text -> hi-fi; no prompt -> reference-only (skips Whisper).
REFERENCE_MODE=auto
WHISPER_BACKEND=faster-whisper
WHISPER_PRELOAD=false
WHISPER_MODEL_NAME=large-v3
WHISPER_COMPUTE_TYPE=int8_float16
WHISPER_VAD=false

# Cache generated reference latents in memory for repeated reference samples.
# Keep only on hosts with sufficient RAM; cache holds compact latents, not uploads.
# Audio intermediates use tmpfs when available; keep final outputs/storage persistent.
TEMP_DIR=storage/temp
AUDIO_TMPFS_DIR=/dev/shm/voxcpm-tmp
AUDIO_MIXER_TEMP_PATH=/dev/shm/audio-mixer-tmp
AUDIO_MIXER_STORAGE_PATH=./storage
AUDIO_TMPFS_FALLBACK_DIR=./storage/temp
AUDIO_MIXER_DEFAULT_OUTPUT_FORMAT=opus

# Never disable the bad-case retry quality guard.
# For mixing jobs, keep durable input payloads by default for restart recovery.
AUDIO_MIXER_MEMORY_JOB_INPUTS=false
AUDIO_MIXER_DATABASE_URL=sqlite:///./storage/audio_mixer.db
SSE_PROGRESS=true

# High-quality fast resampler. It falls back to librosa if soxr is not installed.
AUDIO_RESAMPLER=soxr_hq
# Keep logs useful without exposing user content/audio.
LOG_LEVEL=INFO
